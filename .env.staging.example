# Reference for staging. Copy to `.env.staging` on the host or set equivalent vars in your platform (e.g. Railway).
# Next.js public environment variables
# Browser-exposed variables must use the NEXT_PUBLIC_ prefix.

# Required values

# rails-client-server (BFF). Point at your staging API host in real staging.
NEXT_PUBLIC_CLIENT_SERVER=http://localhost:3100
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth flags
NEXT_PUBLIC_ENABLE_AUTH_VIEWS=true # Enable auth views (login, register, forgot password, reset password)
NEXT_PUBLIC_SHOW_AUTH_BUTTONS=true # Show auth buttons (login, register, forgot password, reset password)

# Optional analytics flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Optional samples repo URL
NEXT_PUBLIC_SAMPLES_REPO_URL=https://github.com/sibabale/rails-sdk-samples

# Optional absolute URL for marketing “Read docs” links (defaults to /infrastructure)
# NEXT_PUBLIC_DOCS_URL=https://docs.example.com