# Reference for staging. Copy to `.env.staging` on the host or set equivalent vars in your platform (e.g. Railway).
# Next.js public environment variables
# Browser-exposed variables must use the NEXT_PUBLIC_ prefix.

# Required values

# rails-client-server (BFF). Point at your staging API host in real staging.
NEXT_PUBLIC_CLIENT_SERVER=http://localhost:3100
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Enable auth views (login, register, forgot password, reset password)
NEXT_PUBLIC_ENABLE_AUTH_VIEWS=true
# Show "Get Started" CTAs in marketing chrome. When true, Read Docs / Read Documentation are outline next to Get Started; when false, filled primary alone. Use ENABLE_AUTH_VIEWS for forms.
NEXT_PUBLIC_SHOW_AUTH_BUTTONS=true

# Optional analytics flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Optional samples repo URL
NEXT_PUBLIC_SAMPLES_REPO_URL=https://github.com/railsinfra/rails-sdk-samples

# Dashboard header repository link (forks override)
NEXT_PUBLIC_GITHUB_REPO_URL=https://github.com/orgs/railsinfra/repositories

# Absolute URL for marketing “Read Documentation” / “Read Docs” (new tab). Set in staging; if unset, a public external fallback is used.
# NEXT_PUBLIC_DOCS_URL=https://docs.example.com