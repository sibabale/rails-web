# Staging — set in Railway (or your host) for the Next build.

NEXT_PUBLIC_CLIENT_SERVER=https://rails-client-server-staging.up.railway.app
NEXT_PUBLIC_SITE_URL=https://rails-web-staging.up.railway.app

NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_key
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

NEXT_PUBLIC_SHOW_AUTH_BUTTONS=false
NEXT_PUBLIC_ENABLE_AUTH_VIEWS=false

# NEXT_PUBLIC_SAMPLES_REPO_URL=https://github.com/your-org/rails-sdk-samples
