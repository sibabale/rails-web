# Rails web (dev)
VITE_CLIENT_SERVER=http://localhost:3000
VITE_SITE_URL=http://localhost:3005
VITE_ALLOW_INDEXING=false
VITE_SEO_TITLE=
# Next.js dev port is set in package.json (`next dev -p 3005`). Override: PORT=3006 npm run dev
# PostHog analytics
VITE_ENABLE_ANALYTICS=true
VITE_POSTHOG_KEY=your_posthog_project_key
VITE_POSTHOG_HOST=https://eu.i.posthog.com
# Show auth buttons in development for testing login/registration flows
VITE_SHOW_AUTH_BUTTONS=true
# Enable auth-related views 
VITE_ENABLE_AUTH_VIEWS=true
# Public GitHub repo for SDK sample folders (Overview → Samples). Omit to use default.
# VITE_SAMPLES_REPO_URL=https://github.com/your-org/rails-sdk-samples