# Local Next.js (npm run dev) — copy to .env.local and adjust.

NEXT_PUBLIC_CLIENT_SERVER=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_key
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

NEXT_PUBLIC_SHOW_AUTH_BUTTONS=true
NEXT_PUBLIC_ENABLE_AUTH_VIEWS=true

# NEXT_PUBLIC_SAMPLES_REPO_URL=https://github.com/your-org/rails-sdk-samples
