# Copy this file to `.env.development` for local work (`cp .env.development.example .env.development`).
# Next.js loads `.env.development` when you run `npm run dev`. Do not commit `.env.development`.
#
# Next.js public environment variables
# Browser-exposed variables must use the NEXT_PUBLIC_ prefix.

# Required values

# rails-client-server (BFF) — browser calls this; it proxies to rails-core in Docker.
NEXT_PUBLIC_CLIENT_SERVER=http://localhost:3100
NEXT_PUBLIC_SITE_URL=http://localhost:3000 # This Next.js app (rails-web)

# Auth flags
NEXT_PUBLIC_ENABLE_AUTH_VIEWS=true # Enable auth views (login, register, forgot password, reset password)
NEXT_PUBLIC_SHOW_AUTH_BUTTONS=true # Show auth buttons (login, register, forgot password, reset password)

# Optional analytics flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Optional samples repo URL
NEXT_PUBLIC_SAMPLES_REPO_URL=https://github.com/railsinfra/rails-sdk-samples

# Optional absolute URL for marketing “Read docs” links (defaults to /infrastructure)
# NEXT_PUBLIC_DOCS_URL=https://docs.example.com

# Marketing copy A/B (all public marketing pages): `a` (default) or `d`. Use ?copy=a or ?copy=d in the URL.
# PostHog (when configured) receives `marketing_copy_exposure` once per variant per browser session.
# NEXT_PUBLIC_MARKETING_COPY_VARIANT=a