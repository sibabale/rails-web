# Copy this file to `.env.development` for local work (`cp .env.development.example .env.development`).
# Next.js loads `.env.development` when you run `npm run dev`. Do not commit `.env.development`.
#
# Next.js public environment variables
# Browser-exposed variables must use the NEXT_PUBLIC_ prefix.

# Required values

# rails-client-server (BFF) — browser calls this; it proxies to rails-core in Docker.
NEXT_PUBLIC_CLIENT_SERVER=http://localhost:3100
# This Next.js app (rails-web)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Enable auth views (login, register, forgot password, reset password)
NEXT_PUBLIC_ENABLE_AUTH_VIEWS=true
# Show every "Get Started" / auth CTA (marketing header, hero, CTA strip, auth shell, legacy Navbar). When true, Read Documentation / Read Docs use outline (secondary) next to Get Started; when false, they use primary (filled) alone. Not the forms themselves.
NEXT_PUBLIC_SHOW_AUTH_BUTTONS=true

# Optional analytics flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Optional samples repo URL
NEXT_PUBLIC_SAMPLES_REPO_URL=https://github.com/railsinfra/rails-sdk-samples

# Absolute URL for marketing “Read Documentation” / “Read Docs” (opens in a new tab). If unset, a public external fallback is used—set this for real docs.
# NEXT_PUBLIC_DOCS_URL=https://docs.example.com

# Marketing copy A/B: variant is chosen by PostHog (multivariate flag) and stored in sessionStorage—URLs stay clean.
# In PostHog: multivariate flag key below; variant keys must be `control` (maps to copy A) and `d` for Experiments + this app. 50/50 rollout typical.
# Optional override when PostHog is off or as fallback: `a` or `d`.
# NEXT_PUBLIC_MARKETING_COPY_VARIANT=a
# NEXT_PUBLIC_POSTHOG_MARKETING_COPY_FLAG_KEY=marketing_site_copy
# Dev-only: `localStorage.setItem('rails_mkt_copy_dev', 'd')` forces copy D when PostHog is enabled (development builds only).
