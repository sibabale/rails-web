# Next.js public environment variables
# Browser-exposed variables must use NEXT_PUBLIC_ prefix.

NEXT_PUBLIC_CLIENT_SERVER=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3005
NEXT_PUBLIC_ENABLE_AUTH_VIEWS=true
NEXT_PUBLIC_SHOW_AUTH_BUTTONS=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_SAMPLES_REPO_URL=https://github.com/sibabale/rails-sdk-samples
