# Production — set in Railway (or your host) for the Next build.

NEXT_PUBLIC_CLIENT_SERVER=https://rails-client-server-production.up.railway.app
NEXT_PUBLIC_SITE_URL=https://rails-web-production.up.railway.app

# PostHog — set at build time so the key is available to the client bundle.
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Set NEXT_PUBLIC_ENABLE_ANALYTICS=false to disable.
NEXT_PUBLIC_ENABLE_ANALYTICS=true

NEXT_PUBLIC_SHOW_AUTH_BUTTONS=false
NEXT_PUBLIC_ENABLE_AUTH_VIEWS=false

# NEXT_PUBLIC_SAMPLES_REPO_URL=https://github.com/your-org/rails-sdk-samples
